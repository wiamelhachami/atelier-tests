{
  "name": "atelier-tests",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage",
    "test:int": "jest tests/integration --runInBand",
    "test:e2e": "playwright test"
  },
  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "/e2e/"],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "lines": 80,
        "functions": 70
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
